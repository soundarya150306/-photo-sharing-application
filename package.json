{
  "name": "photo-sharing-platform-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "setup": "cd server && npm run setup",
    "seed": "cd server && npm run seed",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd server && npm run build && cd ../client && npm run build",
    "vercel-build": "cd server && npm install && npm run build && cd ../client && npm install && npm run build",
    "test": "cd server && npm test",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
